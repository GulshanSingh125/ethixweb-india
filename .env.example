# ==============================================================================
# ETHIXWEB INDIA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your Supabase credentials.
# ==============================================================================

# Supabase Public API Configuration (Safe to expose to client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Server-Side Secret Key (DO NOT EXPOSE TO CLIENT)
# Found in Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Authorized Administrator Emails (Comma-separated list)
# Used to restrict /admin and lead management to verified operators only
ADMIN_EMAILS="admin@ethixweb.com"

# Next.js Application URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
